configuration {
    modi: "drun,run,window";
    show-icons: true;
    font: "JetBrainsMono Nerd Font 12";   /* change to your font */
    drun-display-format: "{icon} {name}";
    display-drun: "Apps";
}

/* Critical for clean transparency */
* {
    background-color: transparent;
    text-color: #cdd6f4;                  /* adjust to taste */
}

window {
    transparency: "real";                 /* preferred on Hyprland (compositor) */
    location: center;
    anchor: center;
    width: 500px;
    border-radius: 12px;
    border: 2px solid;
    border-color: #89b4fa;
    background-color: rgba(30, 30, 46, 0.85);  /* R,G,B,alpha – lower alpha = more transparent */
    padding: 12px;
}

mainbox {
    background-color: transparent;
    children: [ "inputbar", "listview" ];
}

inputbar {
    background-color: rgba(49, 50, 68, 0.9);
    border-radius: 8px;
    padding: 10px;
    children: [ "entry" ];
}

entry {
    background-color: transparent;
    text-color: inherit;
    placeholder: "Search...";
}

listview {
    background-color: transparent;
    lines: 8;
    spacing: 4px;
    padding: 8px 0;
}

element {
    background-color: transparent;
    padding: 8px;
    border-radius: 6px;
}

element selected {
    background-color: rgba(137, 180, 250, 0.4);
    text-color: #1e1e2e;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

element-icon {
    background-color: transparent;
    size: 24px;
}
