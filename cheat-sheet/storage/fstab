NFS CLIENT
──────────────────────────────────────────────────────────────
  sudo apt install nfs-common          # Debian/Ubuntu
  sudo dnf install nfs-utils           # Fedora
  sudo pacman -S nfs-utils             # Arch

  # Temporary mount
  sudo mount -t nfs server:/export /mnt/nfs
  sudo mount -t nfs -o vers=4 server:/export /mnt/nfs

  # fstab entry
  server:/export  /mnt/nfs  nfs  defaults,_netdev,nofail  0  0

  # Common NFS options
  # vers=4 / vers=3
  # soft / hard
  # timeo=10
  # retrans=3
  # rsize=1048576,wsize=1048576

  # Show NFS mounts
  findmnt -t nfs
  mount | grep nfs

// ┌─[ LINUX :: NETWORK SHARES (CIFS / SMB) ]─────────────────┐
// │                                                          │
// └──────────────────────────────────────────────────────────┘

CIFS / SMB CLIENT
──────────────────────────────────────────────────────────────
  sudo apt install cifs-utils          # Debian/Ubuntu
  sudo dnf install cifs-utils          # Fedora
  sudo pacman -S cifs-utils            # Arch

  # Temporary mount (guest)
  sudo mount -t cifs //server/share /mnt/smb -o guest

  # With credentials
  sudo mount -t cifs //server/share /mnt/smb -o username=user,password=pass,uid=1000,gid=1000

  # Better: use credentials file
  # /etc/samba/credentials  (chmod 600)
  # username=user
  # password=pass
  # domain=WORKGROUP

  sudo mount -t cifs //server/share /mnt/smb -o credentials=/etc/samba/credentials,uid=1000,gid=1000,iocharset=utf8

  # fstab entry
  //server/share  /mnt/smb  cifs  credentials=/etc/samba/credentials,uid=1000,gid=1000,iocharset=utf8,_netdev,nofail  0  0

  # Common CIFS options
  # vers=3.0 / vers=2.1 / vers=1.0
  # uid= / gid=
  # file_mode=0644,dir_mode=0755
  # iocharset=utf8
  # noperm
  # cache=strict / cache=loose

