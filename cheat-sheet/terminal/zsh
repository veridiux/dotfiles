// ┌─[ ZSH :: SHELL ]────────────────────────────────────────┐
// │                                                         │
// └─────────────────────────────────────────────────────────┘

VARIABLES
──────────────────────────────────────────────────────────────
  VAR="value"              Create variable
  $VAR                     Expand variable
  ${VAR}                   Explicit variable expansion
  ${VAR:-default}          Use default if unset
  ${VAR:default}           Use default if unset/null


SPECIAL VARIABLES
──────────────────────────────────────────────────────────────
  $0                       Script/function name
  $1                       First argument
  $2                       Second argument
  $@                       All arguments
  $#                       Number of arguments
  $?                       Previous command exit code
  $PWD                     Current directory
  $HOME                    Home directory
  $HOST                     Hostname


COMMAND SUBSTITUTION
──────────────────────────────────────────────────────────────
  $(command)               Insert command output

  example:
    DATE=$(date)


CONDITIONALS
──────────────────────────────────────────────────────────────
  if [[ condition ]]; then
      command
  fi

  if [[ condition ]]; then
      command
  else
      command
  fi


LOOPS
──────────────────────────────────────────────────────────────
  for item in list; do
      command
  done

  while condition; do
      command
  done


READ INPUT
──────────────────────────────────────────────────────────────
  read -r VAR                Read input
  read -q "confirm?Continue?"
                              Read yes/no
  read -r "var?Prompt: "     Read with prompt


FUNCTIONS
──────────────────────────────────────────────────────────────
  function_name() {
      command
  }


ARRAYS
──────────────────────────────────────────────────────────────
  files=(file1 file2 file3)
  ${files[1]}               First item
  ${files[@]}               All items
  ${#files[@]}              Number of items


REDIRECTION
──────────────────────────────────────────────────────────────
  command > file             Write output
  command >> file            Append output
  command 2> file            Redirect errors
  command &> file            Redirect output + errors
  command < file             Read from file
  command | command          Pipe output


OPERATORS
──────────────────────────────────────────────────────────────
  command && command         Run second if first succeeds
  command || command         Run second if first fails
  ! command                  Reverse exit status
