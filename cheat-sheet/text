// │                                                         │
// └─────────────────────────────────────────────────────────┘

VIEW
──────────────────────────────────────────────────────────────
  cat file                  Display file
  less file                 Paginated viewer
  head file                 First 10 lines
  tail file                 Last 10 lines
  tail -f file              Follow file live


SEARCH
──────────────────────────────────────────────────────────────
  grep "text" file          Search text
  grep -n "text" file       Include line numbers
  grep -r "text" directory  Recursive search


SORT
──────────────────────────────────────────────────────────────
  sort file                 Sort lines
  sort -u file              Sort + remove duplicates
  uniq                      Remove adjacent duplicates


COUNT
──────────────────────────────────────────────────────────────
  wc -l file                Count lines
  wc -w file                Count words
  wc -c file                Count bytes


TRANSFORM
──────────────────────────────────────────────────────────────
  cut -d: -f1 file          Extract fields
  sed 's/old/new/g' file    Replace text
  awk '{print $1}' file     Print first field
